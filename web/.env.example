# Backend API URL (used by Next.js route handlers server-side)
BRAIN_API_URL=http://localhost:9200

# Bearer token for the backend API (server-side only, never expose to client)
API_KEY=your-api-key-here

# Next.js public app URL (used by SSR to call the proxy with absolute URL)
# Defaults to http://localhost:3000 if not set
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudflare Access (edge middleware auth gate) ────────────────────────────
# The proxy.ts middleware verifies the Cloudflare Access JWT on every request
# (Cf-Access-Jwt-Assertion header or CF_Authorization cookie). Both variables
# below are REQUIRED — if either is missing the middleware fails closed and
# rejects all requests with a 503.

# Your Cloudflare Zero Trust team domain, used to fetch the Access JWKS
# (https://<team-domain>/cdn-cgi/access/certs) and as the JWT issuer.
# Find it at: Cloudflare Zero Trust dashboard → Settings → Custom Pages
# (or Zero Trust → Access → your team name).<team-name>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# The AUD (audience) tag of the Access application protecting this app.
# Find it at: Zero Trust dashboard → Access → Applications → <this app>
# → Overview → "Application Audience (AUD) Tag".
CF_ACCESS_AUD=
