# Server
PORT=9200

# API Bearer token enforced on /api/v1/* (leave empty to disable auth in dev).
# Generate a strong value with:  openssl rand -hex 32
API_KEY=

# PostgreSQL (pgvector/pgvector:pg16)
DATABASE_URL=postgres://brain:brain@localhost:5432/second_brain?sslmode=disable

# Embedding — issue #34: OpenAI direct (text-embedding-3-small, sk- key)
#
# Routing decision: embeddings call OpenAI directly using a DEDICATED key set
# in EMBEDDING_API_KEY.  cliproxy is chat-only (returns 404 on /v1/embeddings)
# and must NOT be used for this path.
#
# Disabling embeddings: leave EMBEDDING_API_KEY and CLIPROXY_AUTH_FILE empty.
# Search degrades gracefully to full-text-search (FTS) — no crash, no data loss.
#
# Changing EMBEDDING_DIM after data exists requires draining all embeddings first
# (see docs/embedding-dimension.md).  Set BEFORE the first migration.
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension — must match the model's output size.
# text-embedding-3-small  → 1536 (default, backward-compatible)
# multilingual-e5-small-ko (dragonkue/multilingual-e5-small-ko) → 384
EMBEDDING_DIM=1536
# Dedicated OpenAI API key for embeddings (recommended — keeps embedding costs
# separate from chat/LLM costs and allows independent key rotation).
# Use a sk-... key scoped to the embeddings API only.
EMBEDDING_API_KEY=
# Legacy: CliProxyAPI OAuth token file (chat proxies only).
# Only used when EMBEDDING_API_KEY is empty.  cliproxy does NOT support
# /v1/embeddings — use EMBEDDING_API_KEY for OpenAI direct instead.
CLIPROXY_AUTH_FILE=

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_ORG=

# Google Drive service account (optional)
# Paste the contents of your service_account.json as a single line.
GDRIVE_CREDENTIALS_JSON=

# Notion (optional)
NOTION_TOKEN=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Filesystem (local Google Drive sync folder)
FILESYSTEM_PATH=/Users/user/Google Drive/공유 드라이브/<shared-drive>
FILESYSTEM_ENABLED=true

# Additional directory names to skip (merged with built-in defaults:
# .git, node_modules, dist, .next, .omc, .sisyphus, .claude).
# Name-level match, comma-separated. Use this to exclude security-sensitive
# directories (e.g. keys), large caches (.venv, vendor), or editor metadata.
FILESYSTEM_EXCLUDE_DIRS=

# Additional file extensions to skip (merged with built-in defaults: .bak,
# .gitkeep, .plist, .lock, .DS_Store). Comma-separated; leading dot optional.
# Use to exclude source code from being indexed as full text (e.g.
# .js,.ts,.py) when the collector is pointed at a note-oriented vault that
# contains nested code projects.
FILESYSTEM_EXCLUDE_EXTS=

# Scheduler
# How often collectors run. Examples: 1h, 30m, 6h
COLLECT_INTERVAL=1h

# --- Whisper / transcription (OpenAI gpt-4o-transcribe-diarize — default, only operational path) ---
#
# Call/recording audio is sent to OpenAI for transcription + speaker diarization
# in a single API call (deliberate decision, explicit exception to issue #100's
# local-only stance). Transcription is DISABLED entirely if WHISPER_API_KEY is empty.
#
# Base URL of the transcription API (must end with /v1).
WHISPER_API_URL=https://api.openai.com/v1
# OpenAI API key. REQUIRED — empty disables transcription.
WHISPER_API_KEY=
# Model name. gpt-4o-transcribe-diarize combines ASR + speaker diarization.
WHISPER_MODEL=gpt-4o-transcribe-diarize
# BCP-47 language code for transcription. Use "ko" for Korean.
WHISPER_LANGUAGE=ko
# REQUIRED for speaker diarization: verified against the live API that without
# this set to "auto", the response carries no speaker segments at all.
WHISPER_CHUNKING_STRATEGY=auto
# Acknowledges that call audio intentionally leaves the machine for OpenAI
# (#100 exception). Never blocks anything — only changes a log level.
WHISPER_CLOUD_ALLOWED=true
# OpenAI hard limit: 25 MB per audio file.
# Number of concurrent transcription requests the collector sends.
# Tune against OpenAI rate limits when using the cloud path.
WHISPER_CONCURRENCY=1
# Host path to the directory containing audio files for transcription.
WHISPER_AUDIO_DIR=/data/call
#
# --- Local-only fallback (docker-compose.local.yml, --profile local-inference, opt-in) ---
# For environments that cannot send audio to a cloud API. Not enabled by
# default; start with `docker compose --profile local-inference up -d` and
# override the values above:
#   WHISPER_API_URL=http://whisper:8000/v1
#   WHISPER_MODEL=Systran/faster-whisper-medium
# See deploy/whisper-lb/README.md for the distributed 2-node LB variant
# (Caddy LB on the collector host fronting faster-whisper backends,
# WHISPER_API_URL=http://<lb-host>:8770/v1, WHISPER_CONCURRENCY=2).
#
# --- Legacy local pyannote diarization (local-inference profile ONLY) ---
# The native cloud model above always returns speaker labels and IGNORES
# these two variables — they are NOT a cloud-diarization switch. They only
# select the legacy local pyannote.audio service (see deploy/diarization/README.md).
# DIARIZATION_API_URL=http://diarization:8001
# DIARIZATION_ENABLED=false

# --- Discord collector (issue #27) ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_GUILD_IDS=comma_separated_guild_ids
DISCORD_COLLECT_INTERVAL=5m
DISCORD_MENTION_RESPONSE_ENABLED=true

# --- LLM (Discord RAG answer generation + document summarization) ---
#
# Required for summarization (title_summary / bullet_summary / summary_embedding):
#   LLM_API_KEY  — must be set; without it the SummarizerWorker is disabled and
#                  logs "summarizer worker disabled — LLM not configured (set LLM_API_KEY)".
#   LLM_MODEL    — model used for summarization and Discord RAG (default: gpt-4o-mini).
#   EMBEDDING_API_KEY — required for summary_embedding generation (vector search over
#                       summaries).  Without it summary text is stored but summary
#                       vectors are not generated and summary-vec hybrid search is disabled.
#
# Note: SUMMARIZER_ENABLED=false disables the summarizer on a specific replica
# (e.g. all k8s collector pods except a dedicated single summarizer pod).
#
# Base URL for chat completions. Defaults to EMBEDDING_API_URL when unset.
# For cliproxy: same host as EMBEDDING_API_URL (e.g. https://api.openai.com/v1)
LLM_API_URL=
# Static API key for LLM requests. Defaults to EMBEDDING_API_KEY when unset.
# Leave empty to use cliproxy OAuth file instead (LLM_CLIPROXY_AUTH_FILE or CLIPROXY_AUTH_FILE).
# REQUIRED for document summarization (SummarizerWorker).
LLM_API_KEY=
# Cliproxy OAuth file for LLM requests. Defaults to CLIPROXY_AUTH_FILE when unset.
# Set this only when the LLM endpoint uses a different cliproxy account than embeddings.
LLM_CLIPROXY_AUTH_FILE=
# Model name used for chat completions and document summarization.
# Default: gpt-4o-mini  (cost-effective; supports JSON mode required by SummarizerWorker)
LLM_MODEL=gpt-4o-mini
# Maximum tokens in the generated answer (default: 1500)
LLM_MAX_TOKENS=1500
# Sampling temperature — 0.0 (deterministic) to 1.0 (creative). Default: 0.3
LLM_TEMPERATURE=0.3
# Reasoning ("thinking") control for reasoning models such as deepseek-v4-flash.
#   disabled (default) — sends "thinking": {"type": "disabled"}
#   enabled            — omits the parameter, leaving the endpoint's default
# Reasoning tokens are billed against LLM_MAX_TOKENS: with reasoning on, long
# documents burn the whole budget on reasoning and return an EMPTY completion
# with finish_reason=length (measured: 25,388 reasoning chars, 0 content chars
# at LLM_MAX_TOKENS=8000). Set "enabled" only against endpoints that both
# support the parameter and are given a budget large enough for reasoning plus
# the answer.
LLM_THINKING=disabled

# --- Summarizer worker control ---
# Set SUMMARIZER_ENABLED=false on collector replicas that should NOT run
# summarization (e.g. when a dedicated single-replica summarizer pod is used).
# Default: true (all replicas run summarization; FOR UPDATE SKIP LOCKED prevents
# duplicate work across replicas).
SUMMARIZER_ENABLED=true

# Coverage gate for summary-vector hybrid search (#63):
# SummaryVec RRF signal is enabled only when this fraction (0–1) of active
# documents have a non-NULL summary_embedding.  Default: 0.80 (80%).
# Lower this value if you want the signal active sooner during backfill.
SUMMARY_VEC_COVERAGE_THRESHOLD=0.80

# Retention-aware search: score multiplier applied to documents tagged
# metadata.retention="low" (gmail's segmentation pass; SMS to follow), AFTER
# RRF fusion completes, to the final fused score
# (internal/search.applyLowRetentionPenalty). Must be a float in [0, 1]. 1.0
# disables the penalty entirely (score and rank unchanged).
# This is a FUSED SCORE coefficient, not a probability: a fused score is
# roughly 1/(60+1) .. 1/(60+60) for a typical page (k=60). The default 0.8
# multiplies a rank-1 score (1/61) down to ~1/76 — close to the rank-16
# score, i.e. a MILD demotion (roughly rank 1 -> rank 15). A stronger value
# like 0.5 computes to ~1/122 — close to rank 61, which is an effective
# exclusion from a typical page rather than a down-weighting; 0.5 was tried
# and rejected as the default for exactly that reason.
# retention="disposable" documents are excluded outright by default regardless
# of this value (see internal/search.applyRetentionExclusionDefault); this
# knob only tunes the softer "low" penalty. Unset or invalid falls back to
# 0.8 (model.DefaultLowRetentionPenalty).
SEARCH_LOW_RETENTION_PENALTY=0.8

# --- Cross-encoder reranker (optional, Jina-compatible /rerank endpoint) ---
# Post-retrieval reranking is DISABLED entirely when RERANKER_URL is empty,
# regardless of SEARCH_RERANK_DEFAULT below (search.HTTPReranker.Enabled()
# gates on the endpoint, not on the default flag).
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# Whether /ask and the MCP search tool opt into reranking by default (model.
# SearchQuery.UseRerank) unless the caller explicitly overrides it via a
# request parameter. /api/v1/search and the GraphQL search resolver are NOT
# affected — those stay opt-in per request regardless of this flag.
# Default: true (unset/anything-but-false/"0" is on).
SEARCH_RERANK_DEFAULT=true

# How many candidates are sent to the reranker per request. Default: 10.
RERANKER_TOP_N=10

# --- Classification worker (SMS/Gmail/call retention tagging) ---
# Tags newly-collected documents with metadata.segment/retention using a
# deterministic Gate (internal/classify) plus the TypeSafe Jev API for
# anything the Gate cannot decide on its own, backfills the remaining
# untagged historical corpus, and re-audits pre-existing (e.g. ox-alpha) tags
# against the Gate. Opt-in: a vanilla deployment incurs zero Jev spend until
# CLASSIFIER_ENABLED=true is set. Even when disabled/unset, TYPESAFE_API_KEY
# is only a paid third-party dependency — the Gate's own rule-based tags
# (auth/ad/short-call) still work without it.
CLASSIFIER_ENABLED=false

# TypeSafe Jev API key (https://api.typesafe.ai/v1/systemone). Required for
# any document the Gate does not fully decide on its own. Without it, the
# worker still tags Gate-decided documents and simply leaves the rest
# unclassified until a key is configured.
TYPESAFE_API_KEY=

# Minimum Jev segment-choice confidence required before a
# disposable-candidate segment (auth_transient/ad/telemarketing/ars_auto) is
# allowed to become retention=disposable. Below this threshold the document
# falls back to the raw retention score instead. Must be a float in [0, 1].
# Default: 0.9.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.9

# How often the worker polls for new work. Default: 10m.
CLASSIFIER_INTERVAL=10m

# Number of documents processed per tick, per queue (unclassified backfill
# and legacy recheck each get up to this many). Default: 50.
CLASSIFIER_BATCH_SIZE=50

# Restricts the unclassified-backfill queue to documents collected within the
# last N days. 0 (default) means no limit — classify the entire history, not
# just recently-collected documents. Unlike every other CLASSIFIER_* integer
# setting, 0 here is a valid, intentional value, not an error sentinel.
CLASSIFIER_BACKFILL_DAYS=0

# Enables re-auditing pre-existing (non-"rule"/"jev-latest"/"user") retention
# tags — e.g. the ox-alpha mail segmentation pass — against the Gate, fixing
# contradictions (BulkSender-tagged-keep re-classified via Jev;
# PersonSignal-tagged-disposable floored to low+needs_review without a Jev
# call) and marking non-contradictory rows as gate-checked so they are not
# re-scanned on every tick. Default: true.
CLASSIFIER_RECHECK_LEGACY=true

# Maximum number of Jev API calls made in a single tick, shared across both
# the unclassified and legacy-recheck queues. Bounds per-tick spend
# regardless of how large CLASSIFIER_BATCH_SIZE is set. Default: 200.
CLASSIFIER_MAX_CALLS_PER_TICK=200
