==== chunk_fts/exclude ====

		SELECT
			c.id,
			c.document_id,
			c.chunk_index,
			c.content,
			c.byte_size,
			c.created_at,
			GREATEST(
				ts_rank(c.content_tsv, plainto_tsquery('simple', $1)),
				CASE WHEN c.content LIKE '%%' || $1 || '%%' THEN 0.01 ELSE 0 END
			) AS rank,
			d.title          AS document_title,
			d.source_type    AS document_source,
			d.status         AS document_status,
			d.occurred_at    AS document_occurred_at,
			d.collected_at   AS document_collected_at,
			d.metadata       AS document_metadata
		FROM chunks c
		JOIN documents d ON d.id = c.document_id
		WHERE (c.content_tsv @@ plainto_tsquery('simple', $1)
		   OR c.content LIKE '%%' || $1 || '%%')
		  AND d.status = 'active'  AND d.source_type <> ALL($3)  
		ORDER BY rank DESC
		LIMIT $2
---- args ----
$1 = string "이번 주 회의 일정 알려줘"
$2 = int 30
$3 = []model.SourceType []model.SourceType{"insight", "gmail"}
==== sparse_ctx/exclude ====

		WITH fresh AS (
			SELECT
				c.id, c.document_id, c.chunk_index, c.content, c.byte_size, c.created_at,
				GREATEST(
					ts_rank(sc.sparse_tsv, plainto_tsquery('simple', $1)),
					CASE WHEN sc.sparse_text LIKE '%%' || $1 || '%%' THEN 0.01 ELSE 0 END
				) AS rank,
				d.title          AS document_title,
				d.source_type    AS document_source,
				d.status         AS document_status,
				d.occurred_at    AS document_occurred_at,
				d.collected_at   AS document_collected_at,
				d.metadata       AS document_metadata
			FROM chunk_sparse_context sc
			JOIN chunks c ON c.id = sc.chunk_id
			JOIN documents d ON d.id = c.document_id
			WHERE sc.context_version = $3
			  AND sc.fingerprint = md5(d.source_type || E'\x1f' || coalesce(d.title, '') || E'\x1f' || coalesce(d.occurred_at::text, '') || E'\x1f' || coalesce(d.metadata::text, ''))
			  AND (sc.sparse_tsv @@ plainto_tsquery('simple', $1) OR sc.sparse_text LIKE '%%' || $1 || '%%')
			  AND d.status = 'active'  AND d.source_type <> ALL($4)  
			ORDER BY rank DESC
			LIMIT $2
		),
		raw AS (
			SELECT
				c.id, c.document_id, c.chunk_index, c.content, c.byte_size, c.created_at,
				GREATEST(
					ts_rank(c.content_tsv, plainto_tsquery('simple', $1)),
					CASE WHEN c.content LIKE '%%' || $1 || '%%' THEN 0.01 ELSE 0 END
				) AS rank,
				d.title          AS document_title,
				d.source_type    AS document_source,
				d.status         AS document_status,
				d.occurred_at    AS document_occurred_at,
				d.collected_at   AS document_collected_at,
				d.metadata       AS document_metadata
			FROM chunks c
			JOIN documents d ON d.id = c.document_id
			WHERE NOT EXISTS (
				SELECT 1 FROM chunk_sparse_context sc2
				WHERE sc2.chunk_id = c.id
				  AND sc2.context_version = $3
				  AND sc2.fingerprint = md5(d.source_type || E'\x1f' || coalesce(d.title, '') || E'\x1f' || coalesce(d.occurred_at::text, '') || E'\x1f' || coalesce(d.metadata::text, ''))
			)
			AND (c.content_tsv @@ plainto_tsquery('simple', $1) OR c.content LIKE '%%' || $1 || '%%')
			AND d.status = 'active'  AND d.source_type <> ALL($4)  
			ORDER BY rank DESC
			LIMIT $2
		)
		SELECT * FROM fresh
		UNION ALL
		SELECT * FROM raw
		ORDER BY rank DESC
