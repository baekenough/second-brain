			AND status = 'active'
			
			
			
			AND occurred_at >= $4
			AND occurred_at < $5
			LIMIT $3
		),
		entity AS (SELECT NULL::uuid AS id, NULL::bigint AS rank WHERE false),
		rrf AS (
			SELECT
				COALESCE(fts.id, vec.id, bigm.id, summvec.id, entity.id) AS id,
				COALESCE(1::float8/(60::float8 + fts.rank),     0)
				+ COALESCE(1::float8/(60::float8 + vec.rank),     0)
				+ COALESCE(1::float8/(60::float8 + bigm.rank),    0)
				+ COALESCE(0::float8/(60::float8 + summvec.rank), 0)
				+ COALESCE(0::float8/(60::float8 + entity.rank),  0) AS score
			FROM fts
			FULL OUTER JOIN vec     ON fts.id = vec.id
			FULL OUTER JOIN bigm    ON COALESCE(fts.id, vec.id) = bigm.id
			FULL OUTER JOIN summvec ON COALESCE(fts.id, vec.id, bigm.id) = summvec.id
			FULL OUTER JOIN entity  ON COALESCE(fts.id, vec.id, bigm.id, summvec.id) = entity.id
