# Compiled binaries
/bin/
/eval
/server
/collector
/mcp
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output
dist/

# Go workspace
go.work
go.work.sum

# Go test cache
*.test

# Dependency vendor directory (if using vendor mode)
vendor/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.laptop-collector

# Deploy backups (created on every macmini/ubuntu deploy, contain live secrets)
.env.local.bak.*
**/.env.local.bak.*

# CI stub-verification leftovers (can contain real values if run against real .env.local)
.env.local.ci-test-tmp
**/.env.local.ci-test-tmp

# Generic env backup pattern (defense-in-depth for ad-hoc backups)
.env.*.bak

# .env.local.example must stay tracked — CI derives compose stubs from it
!.env.local.example

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
node_modules/
.next/

# TypeScript build info
web/tsconfig.tsbuildinfo

# web/ uses bun (web/bun.lock is the tracked lockfile) — never commit npm's lockfile
web/package-lock.json
.omx/

temp/

# omcustom harness re-init backups (contain stale copies of live .claude/ config —
# grep-based verification can false-positive against these)
.claude-backup-*/

# ontology query cache (regenerated locally, not a source artifact)
.claude/ontology/.cache/
